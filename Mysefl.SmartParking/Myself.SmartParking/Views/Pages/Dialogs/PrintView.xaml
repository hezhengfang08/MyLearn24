<UserControl x:Class="Myself.SmartParking.Views.Pages.Dialogs.PrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Myself.SmartParking.Views.Pages.Dialogs"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Border Background="#f0f0f0" CornerRadius="5"/>

        <TextBlock Text="打印预览" VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="10,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0">
            <TextBlock Text="打印机" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox ItemsSource="{Binding PrinterList}"
                     SelectedItem="{Binding CurrentPrinter}"
                     WindowChrome.IsHitTestVisibleInChrome="True">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Margin="10 0 0 0" Background="#1aa4f5"
                   Width="60" Height="28" HorizontalAlignment="Left" FontSize="12"
                   Style="{StaticResource NormalButtonStyle}" Content="打印" Foreground="White"
                   WindowChrome.IsHitTestVisibleInChrome="True"
                   Command="{Binding PrintCommand}"
                   CommandParameter="{Binding ElementName=border}"></Button>
            <Button Margin="10 0 0 0"
                   Width="60" Height="28" HorizontalAlignment="Left" FontSize="12"
                   Style="{StaticResource NormalButtonStyle}" Content="关闭"
                   WindowChrome.IsHitTestVisibleInChrome="True"
                   Command="{Binding CloseCommand}"></Button>
        </StackPanel>


        <Border Grid.Row="1" Background="#a0a0a0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <!-- 该Border设置成固定A4纸大小 -->
                <Border Background="#fff" Margin="10" Width="794" Height="1123">
                    <!-- 该Border可缩放至打印纸 -->
                    <Border Name="border">
                        <Image Margin="10" Stretch="Uniform" Source="{Binding Image}" 
                              HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Border>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
