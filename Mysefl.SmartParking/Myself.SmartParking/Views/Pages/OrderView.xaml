<UserControl x:Class="Myself.SmartParking.Views.Pages.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Myself.SmartParking.Views.Pages"
             xmlns:converter="clr-namespace:Myself.SmartParking.Base.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="b2v"/>
        <converter:NullValueConverter x:Key="nv"/>
    </UserControl.Resources>
    <Grid Margin="10,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border CornerRadius="5" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" Color="Gray" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="5" Background="White" Grid.Row="2" Margin="0,5,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" Color="Gray" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
        </Border>
        <Grid Margin="10" DataContext="{Binding SearchModel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="33"/>
                <RowDefinition Height="33"/>
                <RowDefinition Height="33"/>
            </Grid.RowDefinitions>
            <TextBlock Text="订单号" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="车牌号" VerticalAlignment="Center" HorizontalAlignment="Center"
                Grid.Row="1"/>
            <TextBlock Text="状态" VerticalAlignment="Center" HorizontalAlignment="Center"
                Grid.Row="2"/>

            <TextBlock Text="入场时间" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="出场时间" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                Grid.Row="1"/>
            <TextBlock Text="计费模式" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                Grid.Row="2"/>

            <TextBlock Text="应付金额" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBlock Text="实付金额" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                Grid.Row="1"/>
            <TextBlock Text="折扣" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                Grid.Row="2"/>


            <TextBox Grid.Column="1" Style="{StaticResource NormalTextBoxStyle}" Height="30"
            Text="{Binding OrderId,Converter={StaticResource nv}}"/>
            <TextBox Grid.Column="1" Grid.Row="1" Style="{StaticResource NormalTextBoxStyle}" Height="30"
            Text="{Binding AutoLicense}"/>
            <TextBox Grid.Column="1" Grid.Row="2" Style="{StaticResource NormalTextBoxStyle}" Height="30"
            Text="{Binding State}"/>

            <TextBox Grid.Column="3" Style="{StaticResource NormalTextBoxStyle}" Height="30"/>
            <TextBox Grid.Column="3" Grid.Row="1" Style="{StaticResource NormalTextBoxStyle}" Height="30"/>
            <TextBox Grid.Column="3" Grid.Row="2" Style="{StaticResource NormalTextBoxStyle}" Height="30"/>

            <TextBox Grid.Column="5" Style="{StaticResource NormalTextBoxStyle}" Height="30"/>
            <TextBox Grid.Column="5" Grid.Row="1" Style="{StaticResource NormalTextBoxStyle}" Height="30"/>
            <TextBox Grid.Column="5" Grid.Row="2" Style="{StaticResource NormalTextBoxStyle}" Height="30"/>

            <Button Content="刷新" Grid.Column="6" Grid.Row="2" Style="{StaticResource NormalButtonStyle}"
            Height="30" Margin="5,0" Foreground="White"
            Command="{Binding DataContext.RefreshCommand,RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FE582D" Offset="0"/>
                        <GradientStop Color="#F1961A" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </Grid>
        <Grid Margin="10,5" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <!--<Border Background="#F7F9FA" Height="1" VerticalAlignment="Bottom"/>-->
            <Grid TextBlock.FontSize="12" TextBlock.FontWeight="Bold" TextBlock.Foreground="#666">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="订单号" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="0"/>
                <TextBlock Text="车牌号" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1"/>
                <TextBlock Text="入场时间" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="2"/>
                <TextBlock Text="出场时间" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="3"/>
                <TextBlock Text="计费模式" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="4"/>
                <TextBlock Text="应付金额" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="5"/>
                <TextBlock Text="实付金额" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="6"/>
                <TextBlock Text="折扣金额" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="7"/>
                <TextBlock Text="状态" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="8"/>
                <TextBlock Text="操作" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="9"/>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding OrderList}" BorderThickness="0"
       AlternationCount="2" ItemContainerStyle="{StaticResource NoramalListBoxItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Name="root" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="33"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Border BorderThickness="0,1,0,0" BorderBrush="#EEE" Grid.ColumnSpan="10" Name="border"/>
                            <TextBlock Text="{Binding OrderId}" Grid.Column="0" VerticalAlignment="Center"
                         Foreground="#888" FontWeight="Bold" TextAlignment="Center"/>
                            <TextBlock Text="{Binding AutoLicense}" Grid.Column="1" VerticalAlignment="Center"
                         HorizontalAlignment="Left" Foreground="#888"/>
                            <TextBlock Text="{Binding EnterTime}" Grid.Column="2" VerticalAlignment="Center" 
                         HorizontalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{Binding LeaveTime}" Grid.Column="3" VerticalAlignment="Center" 
                         HorizontalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{Binding FeeMode}" Grid.Column="4" VerticalAlignment="Center" 
                         HorizontalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{Binding Payable}" Grid.Column="5" VerticalAlignment="Center" 
                         HorizontalAlignment="Center" Foreground="#888"/>
                            <TextBlock Text="{Binding Payment}" 
                         Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center"
                         Foreground="#888"/>
                            <TextBlock Text="{Binding Discount}" Grid.Column="7" VerticalAlignment="Center" 
                         TextWrapping="Wrap" Foreground="#888" HorizontalAlignment="Center"/>
                            <TextBlock Text="待支付" Grid.Column="8" VerticalAlignment="Center" 
                         TextWrapping="Wrap" Foreground="#888" HorizontalAlignment="Center"
                         Name="tb_state"/>

                            <StackPanel Grid.Column="9" VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <CheckBox Content="查看" Name="show_detail"
                              VerticalAlignment="Center" VerticalContentAlignment="Center">
                                    <CheckBox.Template>
                                        <ControlTemplate TargetType="CheckBox">
                                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" Foreground="#409EFE"
                         Cursor="Hand"/>
                                        </ControlTemplate>
                                    </CheckBox.Template>
                                </CheckBox>
                                <TextBlock Margin="3,0">
                      <Hyperlink Command="{Binding DataContext.ModifyCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                 CommandParameter="{Binding}" Foreground="#409EFE"
                                 IsEnabled="{Binding IsCanCancel}">作废</Hyperlink>
                                </TextBlock>
                            </StackPanel>


                            <!--记录详情-->
                            <Border Background="#F7F9FA" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="10" 
                      CornerRadius="5"/>
                            <Grid Grid.Row="1" Name="detail" 
                    Grid.Column="1" Grid.ColumnSpan="10" Margin="10"
                    Visibility="{Binding ElementName=show_detail,Path=IsChecked,Converter={StaticResource b2v}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="35"/>
                                </Grid.RowDefinitions>

                                <Border Width="1" Background="#DDD" Grid.Column="1" Grid.RowSpan="6" HorizontalAlignment="Right"/>
                                <TextBlock HorizontalAlignment="Left" Grid.ColumnSpan="2"
                             VerticalAlignment="Center" FontWeight="Bold" Margin="20,0">
                      <Run Text="&#xe81d;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="Orange"/>
                      <Run Text="入口记录" Foreground="Orange"/>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Left" Grid.Column="2" Grid.ColumnSpan="2"
                             VerticalAlignment="Center" FontWeight="Bold" Margin="20,0">
                      <Run Text="&#xe81d;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="Orange"/>
                      <Run Text="出口记录" Foreground="Orange"/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="记录单号" Margin="10,0"/>
                                    <TextBlock Text="{Binding EnterRecord}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Center">
                                    <TextBlock Text="通过时间" Margin="10,0"/>
                                    <TextBlock Text="{Binding EnterPassTime}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="3" VerticalAlignment="Center">
                                    <TextBlock Text="车辆颜色" Margin="10,0"/>
                                    <TextBlock Text="{Binding EnterCarColor}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="4" VerticalAlignment="Center">
                                    <TextBlock Text="车牌颜色" Margin="10,0"/>
                                    <TextBlock Text="{Binding EnterLicenseColor}" FontWeight="Bold"/>
                                </StackPanel>


                                <Image Source="{Binding EnterImageFull}" Grid.Row="1" Grid.Column="1" Grid.RowSpan="6"/>


                                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="记录单号" Margin="10,0"/>
                                    <TextBlock Text="{Binding ExitRecord}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="通过时间" Margin="10,0"/>
                                    <TextBlock Text="{Binding ExitPassTime}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="车辆颜色" Margin="10,0"/>
                                    <TextBlock Text="{Binding ExitCarColor}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="车牌颜色" Margin="10,0"/>
                                    <TextBlock Text="{Binding ExitLicenseColor}" FontWeight="Bold"/>
                                </StackPanel>


                                <Image Source="{Binding ExitImageFull}" Grid.Row="1" Grid.Column="3" Grid.RowSpan="6"/>
                            </Grid>
                        </Grid>

                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EEE" TargetName="border"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding State}" Value="-1">
                                <Setter TargetName="tb_state" Property="Text" Value="已作废"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="1">
                                <Setter TargetName="tb_state" Property="Text" Value="已完成"/>
                                <Setter TargetName="tb_state" Property="Foreground" Value="Green"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="detail" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="border" Property="Background" Value="#EEE"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
