<UserControl x:Class="Myself.SmartParking.Views.Pages.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Myself.SmartParking.Views.Pages"
              xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1300">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!--第一行-->
        <TextBlock Text="日期区间" VerticalAlignment="Center" Margin="10,0"/>
        <StackPanel Orientation="Horizontal" Margin="75,0,0,0">
            <DatePicker DisplayDateEnd="{Binding ElementName=dp2,Path=SelectedDate}" Name="dp1"
                    SelectedDate="{Binding StartDate}" Width="110" Height="30" Margin="1,0"
                    FontSize="11" VerticalContentAlignment="Center"/>
            <TextBlock Text="－" VerticalAlignment="Center"/>
            <DatePicker IsTodayHighlighted="True" DisplayDateStart="{Binding ElementName=dp1,Path=SelectedDate}" Name="dp2"
                    SelectedDate="{Binding EndDate}" Width="110" Height="30" Margin="1,0" 
                    FontSize="11" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="刷新" Style="{StaticResource NormalButtonStyle}" 
                Command="{Binding RefreshCommand}"
                Width="50" Height="30"/>
            <Button Content="打印" Style="{StaticResource NormalButtonStyle}" 
                Command="{Binding PrintCommand}"
                CommandParameter="{Binding ElementName=datagrid}"
                Width="50" Height="30" Margin="10,0"/>
            <Button Content="导出" Style="{StaticResource NormalButtonStyle}"
                Command="{Binding ExportCommand}" Height="30" Width="50" Foreground="White">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FE582D" Offset="0"/>
                        <GradientStop Color="#F1961A" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
        </StackPanel>


        <Border Grid.Row="1" CornerRadius="5" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" Color="Gray" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="5" Background="White" Grid.Row="2" Margin="0,5,0,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" Color="Gray" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
        </Border>

        <DataGrid Grid.Row="1" AutoGenerateColumns="False" 
              CanUserAddRows="False"
              Background="White" 
              BorderThickness="0"
              ItemsSource="{Binding ReportDatas}" 
              RowHeaderWidth="0" SelectionMode="Single" 
              IsReadOnly="True" GridLinesVisibility="None"
              CanUserSortColumns="False" Margin="0,5" Name="datagrid">
            <DataGrid.Resources>
                <Style x:Key="ColumnHeaderGripperStyle" TargetType="{x:Type Thumb}">
                    <Setter Property="Width" Value="0.5" />
                    <Setter Property="Background" Value="#EEE" />
                    <Setter Property="Cursor" Value="SizeWE" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>


                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                                <Grid>
                                    <Border x:Name="columnHeaderBorder" BorderThickness="0,0,0,1"
                                        BorderBrush="#EEE"
                                        Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                      TextBlock.TextAlignment="Center"/>
                                    </Border>

                                    <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ColumnHeaderGripperStyle}"  />
                                    <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ColumnHeaderGripperStyle}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style TargetType="DataGridCell" x:Key="DataGridCellNormal">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border BorderBrush="#EEE" BorderThickness="1,0,0,1"
                                    Background="{TemplateBinding Background}">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#F7F9FA"/>
                            <Setter Property="Foreground" Value="#444"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="DataGridCell" x:Key="DataGridCellCenter">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border x:Name="border" BorderBrush="#EEE" BorderThickness="1,0,0,1" Background="{TemplateBinding Background}"
                                    Margin="0,0,2,0">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#F7F9FA"/>
                            <Setter Property="Foreground" Value="#444"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="序号" Width="35" Binding="{Binding Index,StringFormat={}{0:00}}"
                                CellStyle="{StaticResource DataGridCellCenter}"/>
                <DataGridTextColumn Header="日期" Width="*" Binding="{Binding Date}"
                                CellStyle="{StaticResource DataGridCellCenter}"/>
                <DataGridTextColumn Header="总订单数" Width="*" Binding="{Binding TotalCount}"
                                CellStyle="{StaticResource DataGridCellCenter}"/>
                <DataGridTextColumn Header="实收金额" Width="*" Binding="{Binding ReceAmount,StringFormat={}{0:C2},ConverterCulture=zh-CN}"
                                CellStyle="{StaticResource DataGridCellCenter}"/>
                <!--列头合并-->
                <DataGridTemplateColumn Width="*" CellStyle="{StaticResource DataGridCellNormal}">
                    <DataGridTemplateColumn.Header>
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1"/>
                            <TextBlock Text="实收金额" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <!--看起来没什么用？   作用很大-->
                                <Border Name="bor1" Margin="0,0"/>
                                <Border Name="bor2" Grid.Column="1" Margin="0,0,0,0"/>
                                <Border Name="bor3" Grid.Column="2"/>



                                <TextBlock Text="现金支付" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="电子支付" TextAlignment="Center" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock Text="小计" TextAlignment="Center" Grid.Column="2" VerticalAlignment="Center"/>

                                <GridSplitter HorizontalAlignment="Right" Width="1" Background="#EEE"/>
                                <GridSplitter HorizontalAlignment="Right" Grid.Column="1" Width="1" Background="#EEE"/>
                            </Grid>
                        </Grid>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="#EEE" Grid.Column="0" Width="{Binding ElementName=bor1,Path=ActualWidth}"/>
                                <Border BorderBrush="#EEE" BorderThickness="1,0" Grid.Column="1" Width="{Binding ElementName=bor2,Path=ActualWidth}"/>
                                <Border BorderBrush="#EEE" Grid.Column="2" Width="{Binding ElementName=bor3,Path=ActualWidth}"/>

                                <TextBlock Text="{Binding CashPayment,StringFormat={}{0:C2},ConverterCulture=zh-CN}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBlock Text="{Binding ElecPayment,StringFormat={}{0:C2},ConverterCulture=zh-CN}" Grid.Column="1"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0"/>
                                <TextBlock Text="{Binding Subtotal,StringFormat={}{0:C2},ConverterCulture=zh-CN}" Grid.Column="2"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="减免金额" Width="*" Binding="{Binding DeduAmount,StringFormat={}{0:C2},ConverterCulture=zh-CN}" 
                                CellStyle="{StaticResource DataGridCellCenter}"/>
            </DataGrid.Columns>
        </DataGrid>


        <Grid Background="White" Grid.Row="2" Margin="5,15,5,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                <Border Background="#0b3d90" Width="4" Height="15"/>
                <TextBlock Text="图表" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0,0,0"/>
            </StackPanel>
            <!--<Label Content="图表" BorderBrush="#0b3d90" BorderThickness="4,0,0,0" Height="15" VerticalContentAlignment="Center" Margin="10,0,0,0"/>-->

            <Grid Grid.Row="2" Name="chartGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <LinearGradientBrush x:Key="c1" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#5FA0F4" Offset="0"/>
                        <GradientStop Color="#5792E0" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="c2" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3DE089" Offset="0"/>
                        <GradientStop Color="#38CC7E" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="c3" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4BDDF2" Offset="0"/>
                        <GradientStop Color="#45C9DD" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="c4" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D9E23E" Offset="0"/>
                        <GradientStop Color="#C5CD38" Offset="1"/>
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="c5" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E0ABFF" Offset="0"/>
                        <GradientStop Color="#CB9BFF" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Resources>
                <!--图例-->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource c1}"/>
                    <TextBlock Text="应收金额" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="5,0,20,0"/>
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource c2}"/>
                    <TextBlock Text="实收金额" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="5,0,20,0"/>
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource c3}"/>
                    <TextBlock Text="减免金额" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="5,0,20,0"/>
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource c4}"/>
                    <TextBlock Text="减免金额" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="5,0,20,0"/>
                    <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource c5}"/>
                    <TextBlock Text="减免金额" FontSize="10" VerticalAlignment="Center" Foreground="#888" Margin="5,0,20,0"/>
                </StackPanel>
                <!--图表-->
                <lvc:CartesianChart Grid.Row="1" Margin="10">
                    <lvc:CartesianChart.Series>
                        <!--1、序列不固定：2、3、4、5个序列  绑定CartesianChart.Series属性  
                   VM  定义SeriesCollection类型的属性  并且往里添加ColumnSeries这个类型-->
                        <!--2、序列固定：  5个序列   在VM中创建5个Value的集合属性 
                   VM  定义ChartValues<double>   ChartValues<ObservableValue>-->
                        <lvc:ColumnSeries Values="{Binding Series1Value}" Fill="{StaticResource c1}" 
                              Title="应收金额" MaxColumnWidth="12"/>
                        <lvc:ColumnSeries Values="{Binding Series2Value}" Fill="{StaticResource c2}" 
                              Title="实收金额" MaxColumnWidth="12"/>
                        <lvc:ColumnSeries Values="{Binding Series3Value}" Fill="{StaticResource c3}" MaxColumnWidth="12"/>
                        <lvc:ColumnSeries Values="{Binding Series4Value}" Fill="{StaticResource c4}" MaxColumnWidth="12"/>
                        <lvc:ColumnSeries Values="{Binding Series5Value}" Fill="{StaticResource c5}" MaxColumnWidth="12"/>
                    </lvc:CartesianChart.Series>

                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Labels="{Binding XLabels}">
                            <lvc:Axis.Separator>
                                <lvc:Separator StrokeThickness="0" Step="1"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis MinValue="0" MaxValue="30">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="500"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
